node_modules/

# Tauri: o compilado do Rust e a cópia do servidor que o instalador leva.
# Os dois são gerados por `npm run build:app` e pesam ~100 MB cada.
src-tauri/target/
src-tauri/servidor/
*.log
dados.db
dados.db-wal
dados.db-shm
uploads/
.backup-*/
.front-backup-*/
.tmp-migracao/
.env
.env.*
!.env.example
*.tmp
*.bak
Thumbs.db
.DS_Store
dist/

# Rust: o compilado do encaixe em WebAssembly. Gerado por `npm run build:wasm`;
# o que vale é o `estatico/encaixe.wasm` que sai dele.
wasm/target/

# Bancada do encaixe: as corridas de medição. O que vale é o código que mede,
# não o número de uma máquina num dia.
bancada/*.json
bancada/.saida-*.txt
