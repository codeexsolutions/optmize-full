{
  "name": "optimize",
  "version": "1.0.26",
  "description": "Optimize: biblioteca de moldes, encaixe de peças no tecido, vetorização de imagem e a central das impressoras da produção.",
  "main": "servidor/server.js",
  "type": "commonjs",
  "scripts": {
    "icones": "node empacotar/icones.js",
    "front": "npm run icones && npm run ia && npm run motor && vite build",
    "dev:app": "vite",
    "prestart": "npm run front",
    "start": "node servidor/server.js",
    "dev": "node --watch servidor/server.js",
    "check": "node --check servidor/server.js",
    "bancada": "node bancada/medir.js",
    "bancada:conferir": "node bancada/conferir.js",
    "bancada:gravacao": "node bancada/conferir-gravacao.js",
    "bancada:cor": "node bancada/conferir-cor.js",
    "bancada:whatsapp": "node bancada/conferir-whatsapp.js",
    "bancada:pdf": "node bancada/conferir-pdf.js",
    "bancada:pdf-entrada": "node bancada/conferir-pdf-entrada.cjs",
    "bancada:molde-imagem": "node bancada/conferir-molde-da-imagem.cjs",
    "bancada:arte": "node bancada/conferir-arte.js",
    "bancada:grupos": "node bancada/conferir-grupos.js",
    "bancada:corte": "node bancada/conferir-bancada.js",
    "bancada:sobreposicao": "node bancada/conferir-sobreposicao.js",
    "bancada:vaos": "node bancada/vaos.js",
    "bancada:tela": "node bancada/conferir-tela.cjs",
    "bancada:react": "node bancada/conferir-react.cjs",
    "bancada:licenca": "node bancada/conferir-licenca.cjs",
    "tipos": "tsc --noEmit",
    "app": "npm run front && tauri dev",
    "build:app": "npm run front && tauri build",
    "tauri": "tauri",
    "build:wasm": "cd wasm && cargo build --release --target wasm32-unknown-unknown && cd .. && node -e \"require('fs').copyFileSync('wasm/target/wasm32-unknown-unknown/release/encaixe.wasm','estatico/encaixe.wasm')\"",
    "ia": "node empacotar/ia.js",
    "motor": "node empacotar/motor.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "bytenode": "^1.6.0",
    "express": "^4.19.2",
    "iconv-lite": "^0.6.3",
    "jpeg-js": "^0.4.4",
    "multer": "^2.2.0",
    "pdfkit": "^0.15.0",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.1",
    "whatsapp-web.js": "^1.34.7",
    "xml2js": "^0.6.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "lucide-static": "^1.37.0",
    "onnxruntime-web": "^1.29.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
