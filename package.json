{
  "name": "optimize",
  "version": "1.0.18",
  "description": "Optimize: biblioteca de moldes, encaixe de peças no tecido e vetorização de imagem.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "icones": "node empacotar/icones.js",
    "css": "tailwindcss -i estilo/entrada.css -o public/tailwind.css --minify",
    "front": "npm run icones && npm run css && vite build",
    "dev:app": "vite",
    "css:dev": "tailwindcss -i estilo/entrada.css -o public/tailwind.css --watch",
    "prestart": "npm run front",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node --check server.js",
    "bancada": "node bancada/medir.js",
    "bancada:conferir": "node bancada/conferir.js",
    "bancada:pdf": "node bancada/conferir-pdf.js",
    "bancada:arte": "node bancada/conferir-arte.js",
    "bancada:grupos": "node bancada/conferir-grupos.js",
    "bancada:corte": "node bancada/conferir-bancada.js",
    "bancada:sobreposicao": "node bancada/conferir-sobreposicao.js",
    "bancada:vaos": "node bancada/vaos.js",
    "tipos": "tsc --noEmit",
    "app": "npm run front && tauri dev",
    "build:app": "npm run front && tauri build",
    "tauri": "tauri",
    "build:wasm": "cd wasm && cargo build --release --target wasm32-unknown-unknown && cd .. && node -e \"require('fs').copyFileSync('wasm/target/wasm32-unknown-unknown/release/encaixe.wasm','estatico/encaixe.wasm')\""
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^4.19.2",
    "jpeg-js": "^0.4.4",
    "pdfkit": "^0.15.0"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "lucide-static": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
