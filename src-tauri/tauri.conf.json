{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Optimize",
  "version": "1.1.0",
  "identifier": "br.com.optimize.desktop",
  "build": {
    "frontendDist": "../empacotar/janela",
    "beforeBuildCommand": "node empacotar/preparar.js && node empacotar/compilar.js",
    "beforeDevCommand": "node empacotar/preparar.js"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://optmize-backend-production.up.railway.app/app/update/tauri/{{target}}-{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCQkE4MUNFMzVCMjhDRTYKUldUbWpMSTF6b0c2TytmS1dnM25jSDYrVjdkKzFTakQ2d0hxMnJteW9JcHF0TXFlUG8yRzZOdG4K",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Optimize",
    "copyright": "",
    "category": "Productivity",
    "shortDescription": "Moldes, encaixe e vetor",
    "longDescription": "Biblioteca de moldes, encaixe das peças no tecido e vetorização de imagem.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "servidor/**/*"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHooks": "ganchos.nsh",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
